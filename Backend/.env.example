# ──────────────────────────────────────────────
# LastMile Carbon — Environment Configuration
# ──────────────────────────────────────────────

# Port for Express HTTP server
PORT=4000

# PostgreSQL Database Connection String (Neon, Supabase, or local Postgres)
DATABASE_URL="postgresql://postgres:postgres@localhost:5432/lastmile_carbon?schema=public"

# JWT Secret Key for token signature verification
JWT_SECRET="lastmile_carbon_hackathon_jwt_secret_key_2026_super_secure"

# JWT Expiries for different user roles
JWT_RIDER_EXPIRY="7d"
JWT_ADMIN_EXPIRY="24h"
JWT_BUYER_EXPIRY="24h"

# Demo OTP for Rider Login (mocked for hackathon demo)
DEMO_OTP="1234"

# Mapbox Access Token (for real route distance & congestion API calls)
# Get a free key at https://account.mapbox.com
MAPBOX_ACCESS_TOKEN="pk.eyJ1IjoibGFzdG1pbGVjYXJib24iLCJhIjoiY2x6c2FtcGxlIn0.sample_token"

# Razorpay API Credentials (substituting Stripe per prompt instructions)
# Razorpay Orders/Payments for Corporate Buyer Credit purchases
# RazorpayX Payouts for Rider Reward Payouts
# Get sandbox keys at https://dashboard.razorpay.com
RAZORPAY_KEY_ID="rzp_test_samplekeyid123"
RAZORPAY_KEY_SECRET="samplekeysecret456789"

# CORS Allowed Origins (comma-separated list of deployed frontend URLs and local dev origins)
ALLOWED_ORIGINS="https://lmc-beige.vercel.app,https://lastmilecarbon.vercel.app,https://lastmilecarbon.app,*"

# Node Environment ('development', 'production', or 'test')
NODE_ENV="development"
